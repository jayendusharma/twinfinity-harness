  "$defs": {
    "sha1": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "issue_number_decimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "pattern": "^(?:[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])(?![\\s\\S])"
    },
    "external_size_decimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "pattern": "^(?:[1-9][0-9]{0,8}|10[0-6][0-9]{7}|107[0-2][0-9]{6}|1073[0-6][0-9]{5}|10737[0-3][0-9]{4}|1073740[0-9]{3}|1073741[0-7][0-9]{2}|10737418[0-1][0-9]|107374182[0-4])(?![\\s\\S])"
    },
    "file_identity_decimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,19})(?![\\s\\S])"
    },
    "absolute_tool_path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 300,
      "pattern": "^/(?:[A-Za-z0-9._+-]+/)*[A-Za-z0-9._+-]+(?![\\s\\S])"
    },
    "output_count_decimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 7,
      "pattern": "^(?:0|[1-9][0-9]{0,5}|10[0-3][0-9]{4}|104[0-7][0-9]{3}|1048[0-4][0-9]{2}|10485[0-6][0-9]|104857[0-6])(?![\\s\\S])"
    },
    "git_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "tree": {
          "$ref": "#/$defs/sha1"
        }
      }
    },
    "git_tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "base_blob",
        "base_sha256",
        "head_blob",
        "head_sha256",
        "execution_source"
      ],
      "properties": {
        "name": {
          "enum": [
            "accepted_base_verifier",
            "receipt_schema",
            "candidate_runner",
            "skill_validator",
            "executor_registry_audit",
            "executor_registry_dependency"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[A-Za-z0-9._/-]+(?![\\s\\S])"
        },
        "base_blob": {
          "$ref": "#/$defs/sha1"
        },
        "base_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "head_blob": {
          "$ref": "#/$defs/sha1"
        },
        "head_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_source": {
          "enum": [
            "ACCEPTED_BASE",
            "SEALED_ACCEPTED_BASE_MEMFD",
            "NOT_EXECUTED"
          ]
        }
      }
    },
    "external_tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "logical_path",
        "resolved_path",
        "sha256",
        "size",
        "device",
        "inode",
        "mode",
        "uid",
        "gid",
        "link_count",
        "mtime_ns",
        "ctime_ns"
      ],
      "properties": {
        "name": {
          "enum": [
            "python",
            "git"
          ]
        },
        "logical_path": {
          "$ref": "#/$defs/absolute_tool_path"
        },
        "resolved_path": {
          "$ref": "#/$defs/absolute_tool_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/external_size_decimal"
        },
        "device": {
          "$ref": "#/$defs/file_identity_decimal"
        },
        "inode": {
          "$ref": "#/$defs/file_identity_decimal"
        },
        "mode": {
          "$ref": "#/$defs/file_identity_decimal"
        },
        "uid": {
          "$ref": "#/$defs/file_identity_decimal"
        },
        "gid": {
          "$ref": "#/$defs/file_identity_decimal"
        },
        "link_count": {
          "$ref": "#/$defs/file_identity_decimal"
        },
        "mtime_ns": {
          "$ref": "#/$defs/file_identity_decimal"
        },
        "ctime_ns": {
          "$ref": "#/$defs/file_identity_decimal"
        },
        "execution_source": {
          "const": "PINNED_KERNEL_EXECUTABLE_FD"
        },
        "execution_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "root",
        "kind",
        "argv",
        "timeout_seconds",
        "output_limit_bytes"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^(?:base|head):(?:skill:[a-z0-9./-]+|executor-registry-audit)(?![\\s\\S])"
        },
        "root": {
          "enum": [
            "BASE",
            "HEAD"
          ]
        },
        "kind": {
          "enum": [
            "SKILL_VALIDATOR",
            "EXECUTOR_REGISTRY_AUDIT"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 3,
          "maxItems": 7,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "timeout_seconds": {
          "const": "60"
        },
        "output_limit_bytes": {
          "const": "1048576"
        }
      }
    },
    "command_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "commands"
      ],
      "properties": {
        "schema": {
          "const": "twinfinity-harness-bootstrap-command-manifest/v1"
