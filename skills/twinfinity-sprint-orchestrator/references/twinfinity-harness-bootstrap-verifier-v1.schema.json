            {
              "$ref": "#/$defs/command_catalog"
            }
          ]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "root",
        "kind",
        "argv",
        "timeout_seconds",
        "output_limit_bytes",
        "execution_source",
        "execution_seals",
        "executed_tool_sha256",
        "executed_dependency_sha256",
        "executed_python_source",
        "executed_python_sha256",
        "exit_code",
        "timed_out",
        "output_limited",
        "descendants_detected",
        "cleanup_verified",
        "stdout_bytes",
        "stdout_sha256",
        "stderr_bytes",
        "stderr_sha256"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "root": {
          "enum": [
            "BASE",
            "HEAD"
          ]
        },
        "kind": {
          "enum": [
            "SKILL_VALIDATOR",
            "EXECUTOR_REGISTRY_AUDIT"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 3,
          "maxItems": 7,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "timeout_seconds": {
          "const": "60"
        },
        "output_limit_bytes": {
          "const": "1048576"
        },
        "execution_source": {
          "const": "SEALED_ACCEPTED_BASE_MEMFD"
        },
        "execution_seals": {
          "const": "SEAL|SHRINK|GROW|WRITE"
        },
        "executed_tool_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "executed_dependency_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "executed_python_source": {
          "const": "PINNED_KERNEL_EXECUTABLE_FD"
        },
        "executed_python_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "exit_code": {
          "const": "0"
        },
        "timed_out": {
          "type": "boolean",
          "const": false
        },
        "output_limited": {
          "type": "boolean",
          "const": false
        },
        "descendants_detected": {
          "type": "boolean"
        },
        "cleanup_verified": {
          "type": "boolean",
