{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinfinity.ai/schemas/twinfinity-harness-bootstrap-verifier/v1",
  "title": "Twinfinity immutable accepted-base harness verifier receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "issue_number",
    "packet_sha256",
    "base",
    "head",
    "candidate_receipt_sha256",
    "tool_identities",
    "external_tools",
    "command_manifest",
    "command_manifest_sha256",
    "observations",
    "verdict",
    "evidence_scope"
  ],
  "properties": {
    "schema": {
      "const": "twinfinity-harness-bootstrap-verifier/v1"
    },
    "repository": {
      "const": "jayendusharma/twinfinity-harness"
    },
    "issue_number": {
      "$ref": "#/$defs/issue_number_decimal"
    },
    "packet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "base": {
      "$ref": "#/$defs/git_object"
    },
    "head": {
      "$ref": "#/$defs/git_object"
    },
    "candidate_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "tool_identities": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/git_tool_identity"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "accepted_base_verifier"
                },
                "path": {
                  "const": "skills/twinfinity-sprint-orchestrator/scripts/verify_harness_baseline_receipt.py"
                },
                "execution_source": {
                  "const": "ACCEPTED_BASE"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/git_tool_identity"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "receipt_schema"
                },
                "path": {
                  "const": "skills/twinfinity-sprint-orchestrator/references/twinfinity-harness-bootstrap-verifier-v1.schema.json"
                },
                "execution_source": {
                  "const": "ACCEPTED_BASE"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/git_tool_identity"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "candidate_runner"
                },
                "path": {
                  "const": "skills/twinfinity-sprint-orchestrator/scripts/run_harness_baseline_validations.py"
                },
                "execution_source": {
                  "const": "NOT_EXECUTED"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/git_tool_identity"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "skill_validator"
                },
                "path": {
                  "const": "skills/.system/skill-creator/scripts/quick_validate.py"
                },
                "execution_source": {
                  "const": "SEALED_ACCEPTED_BASE_MEMFD"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/git_tool_identity"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "executor_registry_audit"
                },
                "path": {
                  "const": "skills/twinfinity-sprint-orchestrator/scripts/executor_registry.py"
                },
                "execution_source": {
                  "const": "SEALED_ACCEPTED_BASE_MEMFD"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/git_tool_identity"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "executor_registry_dependency"
                },
                "path": {
                  "const": "skills/twinfinity-sprint-orchestrator/scripts/owner_safe_sqlite.py"
                },
                "execution_source": {
                  "const": "SEALED_ACCEPTED_BASE_MEMFD"
                }
              }
            }
          ]
        }
      ],
      "items": false
